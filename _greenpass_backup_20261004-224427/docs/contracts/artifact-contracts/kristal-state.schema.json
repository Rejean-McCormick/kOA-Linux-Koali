        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "value_state": {
      "type": "string",
      "enum": [
        "known",
        "unknown",
        "not_applicable",
        "indeterminate",
        "not_measured"
      ]
    },
    "value_semantics": {
      "type": "string",
      "enum": [
        "boolean",
        "categorical",
        "set",
        "ordinal",
        "scalar",
        "interval",
        "probability",
        "distribution",
        "vector",
        "partial_order",
        "state",
        "temporal"
      ]
    },
    "distribution_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "weight"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "value_semantics",
        "value_state"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "value_semantics": {
          "$ref": "#/$defs/value_semantics"
        },
        "value_state": {
          "$ref": "#/$defs/value_state"
        },
        "value": {},
        "scale_ref": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "enum": [
                  "unknown",
                  "not_applicable",
                  "indeterminate",
                  "not_measured"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "categorical"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "set"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "ordinal"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "scalar"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "interval"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lower",
                  "upper"
                ],
                "properties": {
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  },
                  "lower_inclusive": {
                    "type": "boolean"
                  },
                  "upper_inclusive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "probability"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "distribution"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/distribution_member"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "vector"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "partial_order"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "relation",
                  "compared_to"
                ],
                "properties": {
                  "relation": {
                    "type": "string",
                    "enum": [
                      "lt",
                      "le",
                      "eq",
                      "ge",
                      "gt",
                      "incomparable"
                    ]
                  },
                  "compared_to": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "state"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_state": {
                "const": "known"
              },
              "value_semantics": {
                "const": "temporal"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "record_role": {
      "type": "string",
      "enum": [
        "authoritative_constraint",
        "observed_state",
        "organizational_rule",
        "derived_state",
        "decision",
        "action",
        "reference_knowledge",
        "structural"
      ]
    },
    "actionability_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "human_review",
        "human_decision",
        "manual",
        "prohibited",
        "insufficient_information",
        "not_applicable"
      ]
    },
    "actionability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/actionability_mode"
        },
        "requires_human_validation": {
          "type": "boolean"
        },
        "policy_ref": {
          "$ref": "#/$defs/policy_ref"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
