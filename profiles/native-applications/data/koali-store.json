{
  "$schema": "contracts/artifact-contracts/native-application-data-policy.schema.json",
  "kind": "NativeApplicationDataPolicy",
  "version": "1.0.0",
  "policy_id": "native.koali-store.data",
  "profile_persistence": "persistent",
  "cache_policy": "none",
  "documents_ownership": "external_logical_owner",
  "rollback": {
    "requires_compatible_profile": false
  },
  "upgrade": {
    "checkpoint_when_required": false
  },
  "profile_locations": [
    {
      "root": "xdg_state",
      "relative_path": "koali-store"
    }
  ],
  "cache_locations": []
}
