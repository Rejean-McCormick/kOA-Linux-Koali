{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/profiles/kristal.build.request/2.0.0/payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mapping_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "kristal_contract_set": {
      "type": "string",
      "const": "6.0.0"
    }
  },
  "required": [
    "mapping_profile",
    "requested_outputs",
    "kristal_contract_set"
  ]
}
